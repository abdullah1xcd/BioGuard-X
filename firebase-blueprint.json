{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated BioGuard X user profile and role metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 180 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["super_admin", "administrator", "security_analyst", "operator", "viewer"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "status", "createdAt", "lastLoginAt"]
    },
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Trusted administrator membership document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["super_admin", "administrator"] },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "grantedBy", "createdAt"]
    },
    "BiometricIdentity": {
      "title": "BiometricIdentity",
      "description": "Per-account enrolled identity metadata (templates remain encrypted in backend vault)",
      "type": "object",
      "properties": {
        "identityId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "identityRef": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "registeredModalities": { "type": "array", "description": "Max 3 modalities: face, voice, fingerprint" },
        "featureVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
        "consentRecorded": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["identityId", "identityRef", "displayName", "status", "registeredModalities", "consentRecorded", "createdBy", "createdAt", "updatedAt"]
    },
    "BiometricVaultEntry": {
      "title": "BiometricVaultEntry",
      "description": "Per-account AES-256-GCM encrypted biometric template payload",
      "type": "object",
      "properties": {
        "identityRef": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "encryptedPayload": { "type": "string", "minLength": 1, "maxLength": 900000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["identityRef", "encryptedPayload", "updatedAt"]
    },
    "VerificationRecord": {
      "title": "VerificationRecord",
      "description": "Per-account multimodal biometric verification outcome record",
      "type": "object",
      "properties": {
        "verificationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "identityRef": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "modalities": { "type": "array" },
        "pipeline": { "type": "string", "minLength": 1, "maxLength": 64 },
        "outcome": { "type": "string", "enum": ["match", "no_match", "not_evaluated"] },
        "finalDecision": { "type": "string", "enum": ["VERIFIED", "REJECTED", "INCONCLUSIVE"] },
        "policyDecision": { "type": "string", "enum": ["pending"] },
        "reasonCode": { "type": "string", "minLength": 1, "maxLength": 80 },
        "score": { "type": "number" },
        "riskScore": { "type": "number" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "livenessPassed": { "type": "boolean" },
        "livenessStatus": { "type": "string", "enum": ["LIVENESS PASSED", "LIVENESS FAILED", "INCONCLUSIVE", "NOT SUPPORTED"] },
        "livenessDecision": { "type": "string", "enum": ["PASSED", "FAILED", "INCONCLUSIVE"] },
        "livenessScore": { "type": "number" },
        "challengeVerified": { "type": "boolean" },
        "adaptiveApplied": { "type": "boolean" },
        "groundTruth": { "type": "string", "enum": ["genuine", "impostor", "unlabeled"] },
        "datasetCategory": { "type": "string", "enum": ["operational", "synthetic_qa", "benchmark_eval"] },
        "isTestProbe": { "type": "boolean" },
        "captureFailure": { "type": "boolean" },
        "processingTimeMs": { "type": "number" },
        "confidence": { "type": "number" },
        "identityConfidence": { "type": "number" },
        "sampleQualityScore": { "type": "number" },
        "livenessConfidence": { "type": "number" },
        "confidenceBand": { "type": "string", "enum": ["high", "moderate", "low"] },
        "conflictDetected": { "type": "boolean" },
        "featureVersion": { "type": "string", "maxLength": 32 },
        "faceScore": { "type": "number" },
        "voiceScore": { "type": "number" },
        "fingerprintScore": { "type": "number" },
        "faceQuality": { "type": "number" },
        "voiceQuality": { "type": "number" },
        "fingerprintQuality": { "type": "number" },
        "faceStatus": { "type": "string", "enum": ["MATCH", "NO MATCH", "INCONCLUSIVE", "NOT EVALUATED"] },
        "voiceStatus": { "type": "string", "enum": ["MATCH", "NO MATCH", "INCONCLUSIVE", "NOT EVALUATED"] },
        "fingerprintStatus": { "type": "string", "enum": ["MATCH", "NO MATCH", "INCONCLUSIVE", "NOT EVALUATED"] },
        "matchedMinutiae": { "type": "number" },
        "probeMinutiae": { "type": "number" },
        "operatorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["verificationId", "identityRef", "modalities", "outcome", "policyDecision", "reasonCode", "operatorUid", "createdAt"]
    },
    "RateLimitBucket": {
      "title": "RateLimitBucket",
      "description": "Persistent per-user monotonic rate-limit counter bucket",
      "type": "object",
      "properties": {
        "bucketId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "windowStartMs": { "type": "number" },
        "count": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["bucketId", "windowStartMs", "count", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Per-account append-only operational audit record without raw biometric samples or secrets",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "resourceType": { "type": "string", "minLength": 1, "maxLength": 64 },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "result": { "type": "string", "minLength": 1, "maxLength": 240 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "actorUid", "action", "resourceType", "resourceId", "result", "requestId", "timestamp"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app user notification record",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 140 },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "type": "string", "enum": ["info", "warning", "security", "success"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "userUid", "title", "message", "type", "read", "createdAt"]
    },
    "SecurityAlert": {
      "title": "SecurityAlert",
      "description": "Per-account threat intelligence investigation alert",
      "type": "object",
      "properties": {
        "alertId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 600 },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved"] },
        "assignedTo": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["alertId", "severity", "category", "description", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "AutomationWorkflow": {
      "title": "AutomationWorkflow",
      "description": "Per-account event-driven workflow metadata",
      "type": "object",
      "properties": {
        "workflowId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 400 },
        "enabled": { "type": "boolean" },
        "trigger": { "type": "string", "minLength": 1, "maxLength": 80 },
        "actions": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workflowId", "name", "enabled", "trigger", "actions", "createdBy", "createdAt", "updatedAt"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "Per-account threshold and organization configuration metadata (no secrets)",
      "type": "object",
      "properties": {
        "settingId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "organizationName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "faceThreshold": { "type": "number" },
        "voiceThreshold": { "type": "number" },
        "fingerprintThreshold": { "type": "number" },
        "threeModalThreshold": { "type": "number" },
        "maxHoldHours": { "type": "number" },
        "fusionPolicy": { "type": "string", "enum": ["weighted_score", "strict_and", "hierarchical_adaptive"] },
        "securityPreset": { "type": "string", "enum": ["balanced", "strict", "convenience", "custom"] },
        "strictLiveness": { "type": "boolean" },
        "modalityWeights": { "type": "object", "description": "Optional per-modality weights { face, voice, fingerprint }" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["settingId", "organizationName", "faceThreshold", "voiceThreshold", "fingerprintThreshold", "threeModalThreshold", "maxHoldHours", "updatedAt", "updatedBy"]
    },
    "ApprovalRequest": {
      "title": "ApprovalRequest",
      "description": "Per-account approval workflow record for sensitive biometric actions",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestType": { "type": "string", "enum": ["biometric_deletion", "identity_status_change", "policy_review"] },
        "targetIdentityRef": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "requestedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "requestedByEmail": { "type": "string", "minLength": 3, "maxLength": 180 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedBy": { "type": "string", "maxLength": 128 },
        "reviewNotes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["requestId", "requestType", "targetIdentityRef", "reason", "requestedBy", "requestedByEmail", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles indexed by Firebase Auth UID"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Privileged administrator registry"
    },
    "/users/{userId}/identities/{identityId}": {
      "schema": { "$ref": "#/entities/BiometricIdentity" },
      "description": "Per-account enrolled biometric identity metadata"
    },
    "/users/{userId}/biometric_vault/{identityRef}": {
      "schema": { "$ref": "#/entities/BiometricVaultEntry" },
      "description": "Per-account AES-256-GCM encrypted biometric templates"
    },
    "/users/{userId}/verification_records/{verificationId}": {
      "schema": { "$ref": "#/entities/VerificationRecord" },
      "description": "Per-account verification event metadata records"
    },
    "/users/{userId}/rate_limits/{bucketId}": {
      "schema": { "$ref": "#/entities/RateLimitBucket" },
      "description": "Per-account monotonic rate limit counters"
    },
    "/users/{userId}/audit_logs/{eventId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Per-account append-only operational audit logs"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Per-account notifications"
    },
    "/users/{userId}/security_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/SecurityAlert" },
      "description": "Per-account threat alerts"
    },
    "/users/{userId}/automation_workflows/{workflowId}": {
      "schema": { "$ref": "#/entities/AutomationWorkflow" },
      "description": "Per-account automation center workflow configurations"
    },
    "/users/{userId}/system_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SystemSettings" },
      "description": "Per-account organization and threshold configuration"
    },
    "/users/{userId}/approval_requests/{requestId}": {
      "schema": { "$ref": "#/entities/ApprovalRequest" },
      "description": "Per-account sensitive action approval workflow requests"
    }
  }
}
