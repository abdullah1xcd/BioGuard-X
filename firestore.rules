rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Reusable Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'abdullahmohamedharoon8@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isActiveAccount(userId) {
      return (isBootstrappedAdmin() && isOwner(userId)) || (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.status == 'active'
      );
    }

    function canWriteOwnWorkspace(userId) {
      return (isBootstrappedAdmin() && isOwner(userId)) || (
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.status == 'active' &&
        get(/databases/$(database)/documents/users/$(userId)).data.role != 'viewer'
      );
    }

    // Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'lastLoginAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'status', 'theme', 'createdAt', 'lastLoginAt']) &&
        isValidId(data.uid) &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 180 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.role in ['super_admin', 'administrator', 'security_analyst', 'operator', 'viewer'] &&
        data.status in ['active', 'suspended'] &&
        (!('theme' in data) || data.theme in ['dark', 'light']) &&
        data.createdAt is timestamp &&
        data.lastLoginAt is timestamp;
    }

    function isValidAdminGrant(data) {
      return data.keys().hasAll(['uid', 'role', 'grantedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'grantedBy', 'createdAt']) &&
        isValidId(data.uid) &&
        data.role in ['super_admin', 'administrator'] &&
        data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
        data.createdAt == request.time;
    }

    function isValidBiometricIdentity(data) {
      return data.keys().hasAll(['identityId', 'identityRef', 'displayName', 'status', 'registeredModalities', 'consentRecorded', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['identityId', 'identityRef', 'displayName', 'status', 'registeredModalities', 'featureVersion', 'consentRecorded', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.identityId) &&
        data.identityRef is string && data.identityRef.size() >= 2 && data.identityRef.size() <= 64 && data.identityRef.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.status in ['active', 'inactive'] &&
        data.registeredModalities is list && data.registeredModalities.size() >= 1 && data.registeredModalities.size() <= 3 &&
        data.registeredModalities[0] is string &&
        (!('featureVersion' in data) || (data.featureVersion is string && data.featureVersion.size() >= 1 && data.featureVersion.size() <= 32)) &&
        data.consentRecorded == true &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVaultEntry(data) {
      return data.keys().hasAll(['identityRef', 'encryptedPayload', 'updatedAt']) &&
        data.keys().hasOnly(['identityRef', 'encryptedPayload', 'updatedAt']) &&
        data.identityRef is string && data.identityRef.size() >= 2 && data.identityRef.size() <= 64 && data.identityRef.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.encryptedPayload is string && data.encryptedPayload.size() >= 1 && data.encryptedPayload.size() <= 900000 &&
        data.updatedAt is timestamp;
    }

    function isValidVerificationRecord(data) {
      return data.keys().hasAll(['verificationId', 'identityRef', 'modalities', 'outcome', 'policyDecision', 'reasonCode', 'operatorUid', 'createdAt']) &&
        data.keys().hasOnly([
          'verificationId', 'identityRef', 'modalities', 'pipeline', 'outcome', 'finalDecision', 'policyDecision', 'reasonCode',
          'score', 'riskScore', 'riskLevel', 'livenessPassed', 'livenessStatus', 'livenessDecision', 'livenessScore', 'challengeVerified',
          'adaptiveApplied', 'groundTruth', 'datasetCategory', 'isTestProbe', 'captureFailure', 'processingTimeMs',
          'confidence', 'identityConfidence', 'sampleQualityScore', 'livenessConfidence', 'confidenceBand', 'conflictDetected',
          'featureVersion', 'faceScore', 'voiceScore', 'fingerprintScore', 'faceQuality', 'voiceQuality', 'fingerprintQuality',
          'faceStatus', 'voiceStatus', 'fingerprintStatus', 'matchedMinutiae', 'probeMinutiae',
          'subjectKey', 'partition', 'sampleHash', 'benchmarkBatchId', 'provenanceSignature',
          'operatorUid', 'createdAt'
        ]) &&
        isValidId(data.verificationId) &&
        data.identityRef is string && data.identityRef.size() >= 2 && data.identityRef.size() <= 64 && data.identityRef.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.modalities is list && data.modalities.size() >= 1 && data.modalities.size() <= 3 &&
        data.modalities[0] is string &&
        (!('pipeline' in data) || (data.pipeline is string && data.pipeline.size() <= 64)) &&
        data.outcome in ['match', 'no_match', 'not_evaluated'] &&
        (!('finalDecision' in data) || data.finalDecision in ['VERIFIED', 'REJECTED', 'INCONCLUSIVE']) &&
        data.policyDecision == 'pending' &&
        data.reasonCode is string && data.reasonCode.size() >= 1 && data.reasonCode.size() <= 80 &&
        (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 1)) &&
        (!('riskScore' in data) || (data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100)) &&
        (!('riskLevel' in data) || data.riskLevel in ['low', 'medium', 'high', 'critical']) &&
        (!('livenessPassed' in data) || data.livenessPassed is bool) &&
        (!('livenessStatus' in data) || data.livenessStatus in ['LIVENESS PASSED', 'LIVENESS FAILED', 'INCONCLUSIVE', 'NOT SUPPORTED']) &&
        (!('livenessDecision' in data) || data.livenessDecision in ['PASSED', 'FAILED', 'INCONCLUSIVE']) &&
        (!('livenessScore' in data) || (data.livenessScore is number && data.livenessScore >= 0 && data.livenessScore <= 1)) &&
        (!('challengeVerified' in data) || data.challengeVerified is bool) &&
        (!('adaptiveApplied' in data) || data.adaptiveApplied is bool) &&
        (!('groundTruth' in data) || data.groundTruth in ['genuine', 'impostor', 'unlabeled']) &&
        (!('datasetCategory' in data) || data.datasetCategory in ['operational', 'synthetic_qa', 'benchmark_eval']) &&
        (!('isTestProbe' in data) || data.isTestProbe is bool) &&
        (!('captureFailure' in data) || data.captureFailure is bool) &&
        (!('processingTimeMs' in data) || (data.processingTimeMs is number && data.processingTimeMs >= 0 && data.processingTimeMs <= 120000)) &&
        (!('confidence' in data) || (data.confidence is number && data.confidence >= 0 && data.confidence <= 1)) &&
        (!('identityConfidence' in data) || (data.identityConfidence is number && data.identityConfidence >= 0 && data.identityConfidence <= 1)) &&
        (!('sampleQualityScore' in data) || (data.sampleQualityScore is number && data.sampleQualityScore >= 0 && data.sampleQualityScore <= 1)) &&
        (!('livenessConfidence' in data) || (data.livenessConfidence is number && data.livenessConfidence >= 0 && data.livenessConfidence <= 1)) &&
        (!('confidenceBand' in data) || data.confidenceBand in ['high', 'moderate', 'low']) &&
        (!('conflictDetected' in data) || data.conflictDetected is bool) &&
        (!('featureVersion' in data) || (data.featureVersion is string && data.featureVersion.size() <= 32)) &&
        (!('faceScore' in data) || (data.faceScore is number && data.faceScore >= 0 && data.faceScore <= 1)) &&
        (!('voiceScore' in data) || (data.voiceScore is number && data.voiceScore >= 0 && data.voiceScore <= 1)) &&
        (!('fingerprintScore' in data) || (data.fingerprintScore is number && data.fingerprintScore >= 0 && data.fingerprintScore <= 1)) &&
        (!('faceQuality' in data) || (data.faceQuality is number && data.faceQuality >= 0 && data.faceQuality <= 100)) &&
        (!('voiceQuality' in data) || (data.voiceQuality is number && data.voiceQuality >= 0 && data.voiceQuality <= 100)) &&
        (!('fingerprintQuality' in data) || (data.fingerprintQuality is number && data.fingerprintQuality >= 0 && data.fingerprintQuality <= 100)) &&
        (!('faceStatus' in data) || data.faceStatus in ['MATCH', 'NO MATCH', 'INCONCLUSIVE', 'NOT EVALUATED']) &&
        (!('voiceStatus' in data) || data.voiceStatus in ['MATCH', 'NO MATCH', 'INCONCLUSIVE', 'NOT EVALUATED']) &&
        (!('fingerprintStatus' in data) || data.fingerprintStatus in ['MATCH', 'NO MATCH', 'INCONCLUSIVE', 'NOT EVALUATED']) &&
        (!('matchedMinutiae' in data) || (data.matchedMinutiae is number && data.matchedMinutiae >= 0)) &&
        (!('probeMinutiae' in data) || (data.probeMinutiae is number && data.probeMinutiae >= 0)) &&
        (!('subjectKey' in data) || (data.subjectKey is string && data.subjectKey.size() <= 80)) &&
        (!('partition' in data) || data.partition in ['eval', 'unassigned']) &&
        (!('sampleHash' in data) || (data.sampleHash is string && data.sampleHash.size() <= 128)) &&
        (!('benchmarkBatchId' in data) || (data.benchmarkBatchId is string && data.benchmarkBatchId.size() <= 80)) &&
        (!('provenanceSignature' in data) || (data.provenanceSignature is string && data.provenanceSignature.size() <= 160)) &&
        data.operatorUid == request.auth.uid &&
        data.createdAt == request.time;
    }

    function isValidRateLimitBucket(data) {
      return data.keys().hasAll(['bucketId', 'windowStartMs', 'count', 'updatedAt']) &&
        data.keys().hasOnly(['bucketId', 'windowStartMs', 'count', 'updatedAt']) &&
        isValidId(data.bucketId) &&
        data.windowStartMs is number && data.windowStartMs >= 0 &&
        data.count is int && data.count >= 1 && data.count <= 100000 &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['eventId', 'actorUid', 'action', 'resourceType', 'resourceId', 'result', 'requestId', 'timestamp']) &&
        data.keys().hasOnly(['eventId', 'actorUid', 'action', 'resourceType', 'resourceId', 'result', 'requestId', 'timestamp']) &&
        isValidId(data.eventId) &&
        data.actorUid == request.auth.uid &&
        data.action is string && data.action.size() >= 1 && data.action.size() <= 80 &&
        data.resourceType is string && data.resourceType.size() >= 1 && data.resourceType.size() <= 64 &&
        data.resourceId is string && data.resourceId.size() >= 1 && data.resourceId.size() <= 128 &&
        data.result is string && data.result.size() >= 1 && data.result.size() <= 240 &&
        data.requestId is string && data.requestId.size() >= 1 && data.requestId.size() <= 128 &&
        data.timestamp == request.time;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['notificationId', 'userUid', 'title', 'message', 'type', 'read', 'createdAt']) &&
        data.keys().hasOnly(['notificationId', 'userUid', 'title', 'message', 'type', 'read', 'createdAt']) &&
        isValidId(data.notificationId) &&
        isValidId(data.userUid) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.type in ['info', 'warning', 'security', 'success'] &&
        data.read is bool &&
        data.createdAt is timestamp;
    }

    function isValidSecurityAlert(data) {
      return data.keys().hasAll(['alertId', 'severity', 'category', 'description', 'status', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['alertId', 'severity', 'category', 'description', 'status', 'assignedTo', 'notes', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.alertId) &&
        data.severity in ['low', 'medium', 'high', 'critical'] &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 600 &&
        data.status in ['open', 'investigating', 'resolved'] &&
        (!('assignedTo' in data) || (data.assignedTo is string && data.assignedTo.size() <= 128)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkflow(data) {
      return data.keys().hasAll(['workflowId', 'name', 'enabled', 'trigger', 'actions', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['workflowId', 'name', 'description', 'enabled', 'trigger', 'actions', 'createdBy', 'createdAt', 'updatedAt']) &&
        isValidId(data.workflowId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 400)) &&
        data.enabled is bool &&
        data.trigger is string && data.trigger.size() >= 1 && data.trigger.size() <= 80 &&
        data.actions is list && data.actions.size() >= 1 && data.actions.size() <= 10 &&
        data.actions[0] is string &&
        data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['settingId', 'organizationName', 'faceThreshold', 'voiceThreshold', 'fingerprintThreshold', 'threeModalThreshold', 'maxHoldHours', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly([
          'settingId', 'organizationName', 'faceThreshold', 'voiceThreshold', 'fingerprintThreshold', 'threeModalThreshold',
          'maxHoldHours', 'fusionPolicy', 'securityPreset', 'strictLiveness', 'modalityWeights', 'updatedAt', 'updatedBy'
        ]) &&
        isValidId(data.settingId) &&
        data.organizationName is string && data.organizationName.size() >= 1 && data.organizationName.size() <= 120 &&
        data.faceThreshold is number && data.faceThreshold >= 0.3 && data.faceThreshold <= 0.98 &&
        data.voiceThreshold is number && data.voiceThreshold >= 0.3 && data.voiceThreshold <= 0.98 &&
        data.fingerprintThreshold is number && data.fingerprintThreshold >= 0.3 && data.fingerprintThreshold <= 0.98 &&
        data.threeModalThreshold is number && data.threeModalThreshold >= 0.3 && data.threeModalThreshold <= 0.98 &&
        data.maxHoldHours is number && data.maxHoldHours >= 1 && data.maxHoldHours <= 4 &&
        (!('fusionPolicy' in data) || data.fusionPolicy in ['weighted_score', 'strict_and', 'hierarchical_adaptive']) &&
        (!('securityPreset' in data) || data.securityPreset in ['balanced', 'strict', 'convenience', 'custom']) &&
        (!('strictLiveness' in data) || data.strictLiveness is bool) &&
        (!('modalityWeights' in data) || (
          data.modalityWeights is map &&
          data.modalityWeights.keys().hasOnly(['face', 'voice', 'fingerprint']) &&
          (!('face' in data.modalityWeights) || (data.modalityWeights.face is number && data.modalityWeights.face >= 0.05 && data.modalityWeights.face <= 1.0)) &&
          (!('voice' in data.modalityWeights) || (data.modalityWeights.voice is number && data.modalityWeights.voice >= 0.05 && data.modalityWeights.voice <= 1.0)) &&
          (!('fingerprint' in data.modalityWeights) || (data.modalityWeights.fingerprint is number && data.modalityWeights.fingerprint >= 0.05 && data.modalityWeights.fingerprint <= 1.0))
        )) &&
        data.updatedAt == request.time &&
        data.updatedBy == request.auth.uid;
    }

    function isValidApprovalRequest(data) {
      return data.keys().hasAll(['requestId', 'requestType', 'targetIdentityRef', 'reason', 'requestedBy', 'requestedByEmail', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['requestId', 'requestType', 'targetIdentityRef', 'reason', 'requestedBy', 'requestedByEmail', 'status', 'reviewedBy', 'reviewNotes', 'createdAt', 'updatedAt']) &&
        isValidId(data.requestId) &&
        data.requestType in ['biometric_deletion', 'identity_status_change', 'policy_review'] &&
        data.targetIdentityRef is string && data.targetIdentityRef.size() >= 2 && data.targetIdentityRef.size() <= 64 && data.targetIdentityRef.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500 &&
        isValidId(data.requestedBy) &&
        data.requestedByEmail is string && data.requestedByEmail.size() >= 3 && data.requestedByEmail.size() <= 180 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
        (!('reviewNotes' in data) || (data.reviewNotes is string && data.reviewNotes.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Platform User Profiles & Admin Registry
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().lastLoginAt == request.time &&
        incoming().status == 'active' &&
        (incoming().role == 'operator' || (isBootstrappedAdmin() && incoming().role == 'super_admin'));
      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          (isOwner(userId) && existing().status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'lastLoginAt']) &&
            incoming().lastLoginAt == request.time) ||
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'displayName', 'theme', 'lastLoginAt']))
        );
      allow delete: if false;

      // Persistent monotonic rate limit counters (cannot be reset or deleted by owner)
      match /rate_limits/{bucketId} {
        allow get: if isValidId(userId) && isValidId(bucketId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(bucketId) && isVerifiedUser() && isOwner(userId) &&
          isValidRateLimitBucket(incoming()) &&
          incoming().bucketId == bucketId &&
          incoming().count == 1 &&
          isActiveAccount(userId);
        allow update: if isValidId(userId) && isValidId(bucketId) && isVerifiedUser() && isOwner(userId) &&
          isValidRateLimitBucket(incoming()) &&
          incoming().bucketId == existing().bucketId &&
          isActiveAccount(userId) &&
          (
            (incoming().windowStartMs >= existing().windowStartMs + 10000 && incoming().count == 1) ||
            (incoming().windowStartMs == existing().windowStartMs && incoming().count == existing().count + 1)
          );
        allow delete: if false;
      }

      // Per-Google-Account Isolated Data Subcollections
      match /identities/{identityId} {
        allow get: if isValidId(userId) && isValidId(identityId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(identityId) && isVerifiedUser() && isOwner(userId) &&
          isValidBiometricIdentity(incoming()) &&
          incoming().identityId == identityId &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          canWriteOwnWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(identityId) && isVerifiedUser() && isOwner(userId) &&
          isValidBiometricIdentity(incoming()) &&
          incoming().identityId == existing().identityId &&
          incoming().identityRef == existing().identityRef &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'status', 'registeredModalities', 'featureVersion', 'updatedAt']) &&
          canWriteOwnWorkspace(userId);
        allow delete: if isValidId(userId) && isValidId(identityId) && isVerifiedUser() && isOwner(userId) && canWriteOwnWorkspace(userId);
      }

      // Per-account AES-256-GCM encrypted biometric templates
      match /biometric_vault/{identityRef} {
        allow get: if isValidId(userId) && isValidId(identityRef) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(identityRef) && isVerifiedUser() && isOwner(userId) &&
          isValidVaultEntry(incoming()) &&
          incoming().identityRef == identityRef &&
          canWriteOwnWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(identityRef) && isVerifiedUser() && isOwner(userId) &&
          isValidVaultEntry(incoming()) &&
          incoming().identityRef == existing().identityRef &&
          incoming().diff(existing()).affectedKeys().hasOnly(['identityRef', 'encryptedPayload', 'updatedAt']) &&
          canWriteOwnWorkspace(userId);
        allow delete: if isValidId(userId) && isValidId(identityRef) && isVerifiedUser() && isOwner(userId) && canWriteOwnWorkspace(userId);
      }

      match /verification_records/{verificationId} {
        allow get: if isValidId(userId) && isValidId(verificationId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(verificationId) && isVerifiedUser() && isOwner(userId) &&
          isValidVerificationRecord(incoming()) &&
          incoming().verificationId == verificationId &&
          canWriteOwnWorkspace(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)/identities/$(incoming().identityRef));
        allow update, delete: if false;
      }

      match /audit_logs/{eventId} {
        allow get: if isValidId(userId) && isValidId(eventId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(eventId) && isVerifiedUser() && isOwner(userId) &&
          isValidAuditLog(incoming()) &&
          incoming().eventId == eventId &&
          isActiveAccount(userId);
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(notificationId) && isVerifiedUser() && isOwner(userId) &&
          isValidNotification(incoming()) &&
          incoming().notificationId == notificationId &&
          incoming().userUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          isActiveAccount(userId);
        allow update: if isValidId(userId) && isValidId(notificationId) && isVerifiedUser() && isOwner(userId) &&
          isValidNotification(incoming()) &&
          incoming().notificationId == existing().notificationId &&
          incoming().userUid == existing().userUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
          isActiveAccount(userId);
        allow delete: if isValidId(userId) && isValidId(notificationId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
      }

      match /security_alerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(alertId) && isVerifiedUser() && isOwner(userId) &&
          isValidSecurityAlert(incoming()) &&
          incoming().alertId == alertId &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          canWriteOwnWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(alertId) && isVerifiedUser() && isOwner(userId) &&
          isValidSecurityAlert(incoming()) &&
          incoming().alertId == existing().alertId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          existing().status != 'resolved' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedTo', 'notes', 'updatedAt']) &&
          canWriteOwnWorkspace(userId);
        allow delete: if isValidId(userId) && isValidId(alertId) && isVerifiedUser() && isOwner(userId) && canWriteOwnWorkspace(userId);
      }

      match /automation_workflows/{workflowId} {
        allow get: if isValidId(userId) && isValidId(workflowId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(workflowId) && isVerifiedUser() && isOwner(userId) &&
          isValidWorkflow(incoming()) &&
          incoming().workflowId == workflowId &&
          incoming().createdBy == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          canWriteOwnWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(workflowId) && isVerifiedUser() && isOwner(userId) &&
          isValidWorkflow(incoming()) &&
          incoming().workflowId == existing().workflowId &&
          incoming().createdBy == existing().createdBy &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'enabled', 'trigger', 'actions', 'updatedAt']) &&
          canWriteOwnWorkspace(userId);
        allow delete: if isValidId(userId) && isValidId(workflowId) && isVerifiedUser() && isOwner(userId) && canWriteOwnWorkspace(userId);
      }

      match /system_settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(settingId) && isVerifiedUser() && isOwner(userId) &&
          isValidSettings(incoming()) &&
          incoming().settingId == settingId &&
          canWriteOwnWorkspace(userId);
        allow update: if isValidId(userId) && isValidId(settingId) && isVerifiedUser() && isOwner(userId) &&
          isValidSettings(incoming()) &&
          incoming().settingId == existing().settingId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'organizationName', 'faceThreshold', 'voiceThreshold', 'fingerprintThreshold', 'threeModalThreshold',
            'maxHoldHours', 'fusionPolicy', 'securityPreset', 'strictLiveness', 'modalityWeights', 'updatedAt', 'updatedBy'
          ]) &&
          canWriteOwnWorkspace(userId);
        allow delete: if false;
      }

      match /approval_requests/{requestId} {
        allow get: if isValidId(userId) && isValidId(requestId) && isVerifiedUser() && isOwner(userId) && isActiveAccount(userId);
        allow list: if isVerifiedUser() && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(requestId) && isVerifiedUser() && isOwner(userId) &&
          isValidApprovalRequest(incoming()) &&
          incoming().requestId == requestId &&
          incoming().requestedBy == request.auth.uid &&
          incoming().status == 'pending' &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          !('reviewedBy' in incoming()) &&
          canWriteOwnWorkspace(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)/identities/$(incoming().targetIdentityRef));
        allow update: if isValidId(userId) && isValidId(requestId) && isVerifiedUser() && isOwner(userId) &&
          isValidApprovalRequest(incoming()) &&
          existing().status == 'pending' &&
          incoming().status in ['approved', 'rejected'] &&
          incoming().requestId == existing().requestId &&
          incoming().requestType == existing().requestType &&
          incoming().targetIdentityRef == existing().targetIdentityRef &&
          incoming().requestedBy == existing().requestedBy &&
          incoming().requestedByEmail == existing().requestedByEmail &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().reviewedBy == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewNotes', 'updatedAt']) &&
          canWriteOwnWorkspace(userId);
        allow delete: if false;
      }
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isValidAdminGrant(incoming()) && (isAdmin() || (isBootstrappedAdmin() && isOwner(userId)));
      allow update, delete: if isValidId(userId) && isAdmin() && userId != request.auth.uid;
    }
  }
}
